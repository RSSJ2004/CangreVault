# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Dashboard > Project Settings > API). SOLO la clave pública (anon / publishable).
# NUNCA pongas aquí la service_role key: este archivo se empaqueta en el cliente.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Conexión bancaria (opcional): ID PÚBLICO de la aplicación de Bridge (dash.bridge.com.do → Apps).
# No es un secreto. La clave de API de Bridge NUNCA va aquí (va en secretos de Supabase).
VITE_BRIDGE_APPLICATION_ID=

# ---- Secrets de Edge Functions (NO van en .env del frontend) ----
# Configúralos con: supabase secrets set GROQ_API_KEY=... GROQ_MODEL=...
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# BRIDGE_API_KEY=...                 (dash.bridge.com.do → Llaves de acceso)
# BANK_TOKEN_ENCRYPTION_KEY=...      (32 bytes en base64: openssl rand -base64 32)
# BANK_SYNC_CRON_SECRET=...          (texto aleatorio largo para la sincronización programada)
